# Development defaults: Chipnet, deterministic demo fallback, mainnet disabled.
# Copy to .env.development.local, then fill in local-only values.

APP_NETWORK=chipnet
ENABLE_MAINNET=false
VITE_AUTH_ENABLED=false
VITE_WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_PROJECT_ID=
# Public OPTN Chipnet Fulcrum endpoint. Wallet addresses still come only from WalletConnect.
CHIPNET_INDEXER_URL=wss://electrum-chipnet.optnlabs.com:50004
CHIPNET_BROADCAST_URL=
OPTN_ORIGIN_ALLOWLIST=http://127.0.0.1:8080,http://localhost:8080
SESSION_SECRET=replace-with-a-local-random-session-secret

# Reserved for local Chipnet test tooling. Do not commit, log, expose to Vite,
# or use as a browser-side signing secret. The current demo E2E suite does not
# consume it; WalletConnect remains the live signing boundary.
CHIPNET_DEV_MNEMONIC=

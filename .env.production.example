# Production template. Supply values through the deployment secret manager or
# an ignored local file; never commit this file with real values.

APP_NETWORK=chipnet
ENABLE_MAINNET=false
VITE_AUTH_ENABLED=true
VITE_WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_PROJECT_ID=
# Electrum/Fulcrum WSS (preferred) or Chronik-compatible HTTPS.
CHIPNET_INDEXER_URL=wss://electrum-chipnet.optnlabs.com:50004
CHIPNET_BROADCAST_URL=
MAINNET_INDEXER_URL=
MAINNET_BROADCAST_URL=
OPTN_ORIGIN_ALLOWLIST=https://dashboard.example
SESSION_SECRET=

# Deliberately absent: production must never receive a development mnemonic.

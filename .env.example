# Copy one of the environment-specific examples to an ignored local file.
# Do not commit credentials, mnemonics, private keys, or provider tokens.
# The application defaults to deterministic DEMO mode when live values are absent.

APP_NETWORK=chipnet
ENABLE_MAINNET=false
VITE_AUTH_ENABLED=false
VITE_WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_PROJECT_ID=
# Electrum/Fulcrum WSS (preferred) or Chronik-compatible HTTPS.
CHIPNET_INDEXER_URL=wss://electrum-chipnet.optnlabs.com:50004
CHIPNET_BROADCAST_URL=
MAINNET_INDEXER_URL=
MAINNET_BROADCAST_URL=
OPTN_ORIGIN_ALLOWLIST=http://127.0.0.1:8080,http://localhost:8080
SESSION_SECRET=

# Local test tooling only. Never place this in a production environment.
CHIPNET_DEV_MNEMONIC=
